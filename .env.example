# Frontend
NEXT_PUBLIC_MARKET_WS_URL=ws://127.0.0.1:8000/ws/market

# Auth: configure a random secret (at least 32 characters) and JSON user list.
# Keep this private; do not commit real credentials.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH_USERS=[{"email":"admin@example.com","password":"replace-with-a-unique-password-of-12-characters"}]
# Use the same random secret (at least 32 characters) in the frontend and backend.
NEXUS_MARKET_TOKEN_SECRET=replace-with-a-random-shared-secret-of-at-least-32-characters

# Backend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
FLOW_DB_PATH=backend/data/flow.sqlite3
FLOW_RETENTION_HOURS=1
FLOW_AGG_RETENTION_DAYS=30
FLOW_GAP_RECOVERY_MAX_TRADES=5000
# Marque true apenas se o caminho estiver em volume/banco durável.
FLOW_STORAGE_DURABLE=false
# Opcional: configure com a URL Session pooler do Supabase para persistir em Postgres.
# DATABASE_URL=postgresql://postgres.<projeto>:<senha>@<host-pooler>:5432/postgres
